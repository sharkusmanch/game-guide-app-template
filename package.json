{
  "name": "demo-quest-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "configure": "node scripts/configure-game.mjs",
    "test:hosting": "python3 -m unittest discover -s hosting/test -p '*_test.py' && node --test hosting/test/installer.test.mjs",
    "test:runtime": "node hosting/test/runtime-ci.mjs",
    "install:skill": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
